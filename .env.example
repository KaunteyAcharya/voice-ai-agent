# ============================================================
#  COPY THIS FILE TO .env, THEN PASTE YOUR KEYS BELOW (right after the = sign, no quotes, no spaces)
#  Then double-click start.bat (or run: uv run server/main.py) and open http://localhost:7860
# ============================================================

# Get it free at https://console.groq.com/keys   (starts with gsk_)
GROQ_API_KEY=

# Get it free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional - leave empty unless you want Sarvam voices (https://dashboard.sarvam.ai)
SARVAM_API_KEY=


# ------------------------------------------------------------
#  Everything below is already set up. No need to change it.
# ------------------------------------------------------------
STT_PROVIDER=groq
LLM_PROVIDER=groq
# Backup models tried in order when the main one fails or hits its per-minute limit (provider:model)
LLM_FALLBACK_CHAIN=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,gemini:gemini-3.1-flash-lite
# edge = free Microsoft Edge voices (no key) | gemini (10 free requests/day) | kokoro (local) | sarvam
TTS_PROVIDER=edge
TTS_FALLBACK=kokoro

GROQ_STT_MODEL=whisper-large-v3
SARVAM_STT_MODEL=saaras:v3
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
GROQ_LLM_MODEL=openai/gpt-oss-120b
SARVAM_LLM_MODEL=sarvam-105b
EDGE_VOICE_EN=en-IN-NeerjaNeural
EDGE_VOICE_HI=hi-IN-SwaraNeural
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Sulafat
# How fast Aditi speaks: 1.0 = normal, 1.25 = 25% faster, 0.9 = a little slower (0.5-2.0)
SPEECH_RATE=1.0

KOKORO_VOICE_EN=hf_alpha
KOKORO_VOICE_HI=hf_alpha
SARVAM_TTS_VOICE=priya

# VAD_STOP_SECS: pause that ends your sentence. IDLE_TIMEOUT_SECS: silence before Aditi warns you,
# and the same again before she ends the call.
VAD_STOP_SECS=0.4
IDLE_TIMEOUT_SECS=10

# Follow-up messages with the homes a caller liked.
#   preview  = free, no setup: saved + shown in the UI with a one-tap "Open in WhatsApp" link
#   whatsapp = sent automatically with Meta's WhatsApp Cloud API (free test number, up to 5 verified recipients)
MESSAGE_CHANNEL=preview
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0

HOST=localhost
PORT=7860
LOG_LEVEL=INFO
